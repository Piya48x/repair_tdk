# Copy this file to .env.gatepass-sync and fill in a dedicated Supabase user.
# Use either its employee code or email. The profile role must be security,
# it_support, or admin, and the profile must be active.
GATEPASS_SYNC_IDENTIFIER=employee-code-or-email
GATEPASS_SYNC_PASSWORD=replace-with-a-strong-password

# This is the current automatic report file on the Windows computer.
# Folder containing daily files named "report Car in Day *.xlsx". The newest modified file is selected automatically.
GATEPASS_REPORT_PATH=H:\work_to_day\งานปัจจุบัน\gpt_push\repor_Car_in_day_for_MD
